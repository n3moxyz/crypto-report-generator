# Crypto What's Up - Environment Variables
# Copy this file to .env.local and fill in your values

# Claude API - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Grok/X.AI API - Get from https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# Twitter API (twitterapi.io) - Get from https://twitterapi.io/
# Optional — enhances source verification. App works without it.
TWITTER_API_KEY=your_twitter_api_key_here

# Passwords for internal features.
# For public deployments, set REPORT_PASSWORD, ARCHIVE_PASSWORD, and CRON_SECRET.
# Leaving feature passwords unset is only appropriate for local development.
REPORT_PASSWORD=your_report_password_here
ARCHIVE_PASSWORD=your_archive_password_here
CRON_SECRET=your_cron_secret_here

# Optional admin bypass for manual refresh testing. Leave unset in public deployments
# unless you have a specific operational need and rotate it like a secret.
# ADMIN_BYPASS_TOKEN=your_admin_bypass_token_here

# Daily API budget cap (optional — defaults to 200 requests/day)
# DAILY_API_BUDGET=200
